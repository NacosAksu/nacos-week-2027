cal-align:bottom\"><p style=\"font-size:10px;line-height:24px;margin:0;font-family:Montserrat,Arial,Helvetica,sans-serif;font-weight:700;text-transform:uppercase;letter-spacing:2.4px;color:rgb(141,224,133);margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\">Confluence</p><p style=\"font-size:11px;line-height:24px;margin:0;margin-top:2px;color:rgb(115,128,119);margin-bottom:0;margin-left:0;margin-right:0\">February 2027</p></td></tr></tbody></table></td></tr></tbody></table><table align=\"center\" width=\"100%\" border=\"0\" cellPadding=\"0\" cellSpacing=\"0\" role=\"presentation\"><tbody><tr><td><table align=\"center\" width=\"100%\" border=\"0\" cellPadding=\"0\" cellSpacing=\"0\" role=\"presentation\"><tbody style=\"width:100%\"><tr style=\"width:100%\"><td data-id=\"__react-email-column\" style=\"height:4px;width:68%;background-color:rgb(8,144,2);font-size:0px;line-height:0px\"> </td><td data-id=\"__react-email-column\" style=\"height:4px;width:32%;background-color:rgb(141,224,133);font-size:0px;line-height:0px\"> </td></tr></tbody></table></td></tr></tbody></table><table align=\"center\" width=\"100%\" border=\"0\" cellPadding=\"0\" cellSpacing=\"0\" role=\"presentation\" style=\"border-bottom-right-radius:16px;border-bottom-left-radius:16px;background-color:rgb(255,255,255)\"><tbody><tr><td><img alt=\"Students celebrating on stage at a previous NACOS AKSU event\" src=\"https://nw27.nacosaksu.com.ng/assets/hero/hero-1-1600.jpg\" style=\"display:block;outline:none;border:none;text-decoration:none;height:auto;width:100%\" width=\"600\"/><table align=\"center\" width=\"100%\" border=\"0\" cellPadding=\"0\" cellSpacing=\"0\" role=\"presentation\"><tbody><tr><td style=\"padding-right:36px;padding-left:36px;padding-top:40px\"><p style=\"font-size:11px;line-height:24px;margin:0;margin-bottom:14px;font-family:Montserrat,Arial,Helvetica,sans-serif;font-weight:700;text-transform:uppercase;letter-spacing:2.6px;color:rgb(8,144,2);margin-top:0;margin-left:0;margin-right:0\">The programme · <!-- -->February 2027</p><h1 style=\"margin:0;font-family:Montserrat,Arial,Helvetica,sans-serif;font-size:34px;font-weight:800;line-height:40px;letter-spacing:-0.6px;color:rgb(11,15,12)\">Five events. One flagship week.</h1><p style=\"font-size:16px;line-height:27px;margin:0;margin-top:14px;color:rgb(74,85,78);margin-bottom:0;margin-left:0;margin-right:0\">%%FIRST%%, this<!-- --> is the year NACOS Week opens to the whole university. Every faculty and every student, meeting in one place. Here&#x27;s what&#x27;s on.</p></td></tr></tbody></table><table align=\"center\" width=\"100%\" border=\"0\" cellPadding=\"0\" cellSpacing=\"0\" role=\"presentation\"><tbody><tr><td style=\"padding-right:36px;padding-left:36px;padding-top:12px\"><table align=\"center\" width=\"100%\" border=\"0\" cellPadding=\"0\" cellSpacing=\"0\" role=\"presentation\"><tbody><tr><td><hr style=\"width:100%;border:none;border-color:transparent;border-top:1px solid #DCE3D8;margin:28px 0\"/><a href=\"https://nw27.nacosaksu.com.ng/hackathon\" style=\"color:#067df7;text-decoration-line:none\" target=\"_blank\"><img alt=\"Hackathon, flagship pillar: see details on the website\" src=\"https://nw27.nacosaksu.com.ng/assets/photos/pillar-hackathon-800.jpg\" style=\"display:block;outline:none;border:none;text-decoration:none;height:auto;width:100%;border-radius:12px\" width=\"528\"/></a><p style=\"font-size:10px;line-height:24px;margin:0;margin-top:18px;font-family:Montserrat,Arial,Helvetica,sans-serif;font-weight:700;text-transform:uppercase;letter-spacing:2.2px;color:rgb(8,144,2);margin-bottom:0;margin-left:0;margin-right:0\">01<!-- --> / <!-- -->Flagship</p><p style=\"font-size:21px;line-height:26px;margin:0;margin-top:8px;font-family:Montserrat,Arial,Helvetica,sans-serif;font-weight:800;color:rgb(11,15,12);margin-bottom:0;margin-left:0;margin-right:0\">Hackathon</p><p style=\"font-size:12px;line-height:24px;margin:0;margin-top:4px;font-weight:600;color:rgb(115,128,119);margin-bottom:0;margin-left:0;margin-right:0\">A 4-week build across 4 industry tracks</p><p style=\"font-size:15px;line-height:24px;margin:0;margin-top:8px;color:rgb(74,85,78);margin-bottom:0;margin-left:0;margin-right:0\">Student teams build real solutions to briefs set by sector sponsors, then pitch them live at the Tech Conference.</p></td></tr></tbody></table><table align=\"center\" width=\"100%\" border=\"0\" cellPadding=\"0\" cellSpacing=\"0\" role=\"presentation\"><tbody><tr><td><hr style=\"width:100%;border:none;border-color:transparent;border-top:1px solid #DCE3D8;margin:28px 0\"/><a href=\"https://nw27.nacosaksu.com.ng/programme\" style=\"color:#067df7;text-decoration-line:none\" target=\"_blank\"><img alt=\"Tech Conference Day, conference pillar: see details on the website\" src=\"https://nw27.nacosaksu.com.ng/assets/photos/pillar-conference-800.jpg\" style=\"display:block;outline:none;border:none;text-decoration:none;height:auto;width:100%;border-radius:12px\" width=\"528\"/></a><p style=\"font-size:10px;line-height:24px;margin:0;margin-top:18px;font-family:Montserrat,Arial,Helvetica,sans-serif;font-weight:700;text-transform:uppercase;letter-spacing:2.2px;color:rgb(8,144,2);margin-bottom:0;margin-left:0;margin-right:0\">02<!-- --> / <!-- -->Conference</p><p style=\"font-size:21px;line-height:26px;margin:0;margin-top:8px;font-family:Montserrat,Arial,Helvetica,sans-serif;font-weight:800;color:rgb(11,15,12);margin-bottom:0;margin-left:0;margin-right:0\">Tech Conference Day</p><p style=\"font-size:12px;line-height:24px;margin:0;margin-top:4px;font-weight:600;color:rgb(115,128,119);margin-bottom:0;margin-left:0;margin-right:0\">Energy, FinTech, Oil &amp; Gas, Medicine</p><p style=\"font-size:15px;line-height:24px;margin:0;margin-top:8px;color:rgb(74,85,78);margin-bottom:0;margin-left:0;margin-right:0\">Keynotes and panels from industry, the hackathon exhibition, and live judging on the main stage.</p></td></tr></tbody></table><table align=\"center\" width=\"100%\" border
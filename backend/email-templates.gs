,12);margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\">Orientation</p><p style=\"font-size:14px;line-height:22px;margin:0;margin-top:4px;color:rgb(74,85,78);margin-bottom:0;margin-left:0;margin-right:0\">A short briefing on the week, your duties and who you report to.</p></td></tr></tbody></table><table align=\"center\" width=\"100%\" border=\"0\" cellPadding=\"0\" cellSpacing=\"0\" role=\"presentation\" style=\"margin-bottom:18px\"><tbody style=\"width:100%\"><tr style=\"width:100%\"><td data-id=\"__react-email-column\" style=\"width:48px;vertical-align:top\"><p style=\"font-size:13px;line-height:24px;margin:0;font-family:Montserrat,Arial,Helvetica,sans-serif;font-weight:800;color:rgb(8,144,2);margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\">03</p></td><td data-id=\"__react-email-column\" style=\"vertical-align:top\"><p style=\"font-size:15px;line-height:24px;margin:0;font-family:Montserrat,Arial,Helvetica,sans-serif;font-weight:700;color:rgb(11,15,12);margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\">Crew kit</p><p style=\"font-size:14px;line-height:22px;margin:0;margin-top:4px;color:rgb(74,85,78);margin-bottom:0;margin-left:0;margin-right:0\">Your accreditation and crew wear are issued before the week opens.</p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><table align=\"center\" width=\"100%\" border=\"0\" cellPadding=\"0\" cellSpacing=\"0\" role=\"presentation\" style=\"text-align:center\"><tbody><tr><td style=\"padding-right:24px;padding-left:24px;padding-top:28px\"><p style=\"font-size:12px;line-height:24px;margin:0;font-family:Montserrat,Arial,Helvetica,sans-serif;font-weight:700;text-transform:uppercase;letter-spacing:2px;color:rgb(11,15,12);margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\">NACOS Week 2027 · Confluence</p><p style=\"font-size:13px;line-height:20px;margin:0;margin-top:10px;margin-bottom:0;margin-left:0;margin-right:0\"><a href=\"https://nw27.nacosaksu.com.ng\" style=\"color:rgb(0,80,18);text-decoration-line:none;font-weight:600\" target=\"_blank\">Website</a><span style=\"color:rgb(115,128,119)\">  ·  </span><a href=\"https://www.instagram.com/nacos_aksu/\" style=\"color:rgb(0,80,18);text-decoration-line:none;font-weight:600\" target=\"_blank\">Instagram</a><span style=\"color:rgb(115,128,119)\">  ·  </span><a href=\"https://x.com/nacos_aksu\" style=\"color:rgb(0,80,18);text-decoration-line:none;font-weight:600\" target=\"_blank\">X</a><span style=\"color:rgb(115,128,119)\">  ·  </span><a href=\"https://whatsapp.com/channel/0029Vb87N0c9Bb5utsX0yk2R\" style=\"color:rgb(0,80,18);text-decoration-line:none;font-weight:600\" target=\"_blank\">WhatsApp</a></p><p style=\"font-size:12px;line-height:19px;margin:0;margin-top:14px;color:rgb(115,128,119);margin-bottom:0;margin-left:0;margin-right:0\">NACOS AKSU, Faculty of Computing &amp; Information Technology<br/>Akwa Ibom State University, <!-- -->Ikot Akpaden, Mkpat Enin, Akwa Ibom State</p><p style=\"font-size:11px;line-height:17px;margin:0;margin-top:10px;color:rgb(115,128,119);margin-bottom:0;margin-left:0;margin-right:0\">You received this because you applied to volunteer at nw27.nacosaksu.com.ng.<!-- --> Questions? Reply to this email or write to<!-- --> <a href=\"mailto:hello@nacosaksu.com.ng\" style=\"color:rgb(115,128,119);text-decoration-line:underline\" target=\"_blank\">hello@nacosaksu.com.ng</a>.</p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>","text":"https://nw27.nacosaksu.com.ng\n\nConfluence\n\nFebruary 2027\n\n \n \n\nOrganizing Crew · Application received\n\n\nTHANKS FOR STEPPING UP, %%FIRST%%.\n\nA week like Confluence runs on people who show up early and leave last. Your application is in, and the Planning Committee will be in touch with roles and orientation.\n\nOrganizing Crew · NW27\n\nCrew member\n\n%%FIRST%% %%REST%%\n\n%%TEAM%%\n\nCrew ID\n\n%%ID%%\n\nCommittee\n%%TEAM%%\n\nAvailability\n%%AVAILABILITY%%\n\nBase\nConference Centre, Perm Site, Akwa Ibom State University\n\n----------------------------------------\n\nThe road to February\n\n01\n\nReview\n\nCommittee leads read every application and confirm roles over the coming weeks.\n\n02\n\nOrientation\n\nA short briefing on the week, your duties and who you report to.\n\n03\n\nCrew kit\n\nYour accreditation and crew wear are issued before the week opens.\n\nNACOS Week 2027 · Confluence\n\nWebsite https://nw27.nacosaksu.com.ng  ·  Instagram https://www.instagram.com/nacos_aksu/  ·  X https://x.com/nacos_aksu  ·  WhatsApp https://whatsapp.com/channel/0029Vb87N0c9Bb5utsX0yk2R\n\nNACOS AKSU, Faculty of Computing & Information Technology\nAkwa Ibom State University, Ikot Akpaden, Mkpat Enin, Akwa Ibom State\n\nYou received this because you applied to volunteer at nw27.nacosaksu.com.ng. Questions? Reply to this email or write to hello@nacosaksu.com.ng."},"announcement":{"html":"<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\"><html dir=\"ltr\" lang=\"en\"><head><meta content=\"text/html; charset=UTF-8\" http-equiv=\"Content-Type\"/><meta name=\"x-apple-disable-message-reformatting\"/><meta name=\"color-scheme\" content=\"light only\"/><title>A hackathon, a conference, football, fashion and an awards night. Here is the week.</title><style></style><link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&amp;family=Poppins:wght@400;500;600&amp;display=swap\"/></head><body dir=\"ltr\" lang=\"en\" style=\"background-color:rgb(236,239,232);margin:0;padding-top:0;padding-bottom:0;padding-right:0;padding-left:0\"><!--$--><!--html--><!--head--><!--body--><table border=\"0\" width=\"100%\" cellPadding=\"0\" cellSpacing=\"0\" role=\"presentation\" align=\"center\"><tbody><tr><td dir=\"ltr\" lang=\"en\" style=\"margin:0;padding-bottom:32px;padding-top:32px;padding-right:12px;padding-left:12